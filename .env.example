# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Port (Railway sets this automatically)
PORT=8000

# Chromium-Parallelität pro fetch-markdown-batch-Aufruf (Default 3).
# Höher = schneller aber mehr RAM-Spitzen auf der geteilten Box; 3 reicht,
# da httpx der Hauptpfad ist und Chromium nur Fallback.
FETCH_BATCH_CONCURRENCY=3
